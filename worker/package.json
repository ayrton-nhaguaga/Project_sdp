{
  "name": "@cloudexpense/worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "db:migrate": "wrangler d1 migrations apply cloudexpense --local --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:check": "wrangler deploy --dry-run --outdir dist",
    "preview": "wrangler dev --config wrangler.jsonc --var APP_ENV:development --ip 127.0.0.1 --port 8788"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "zod": "^4.1.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "wrangler": "4.149.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "vitest": "5.0.3"
  }
}
