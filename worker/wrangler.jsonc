{
 "$schema": "../node_modules/wrangler/config-schema.json",
 "name": "cloudexpense",
 "main": "src/index.ts",
 "compatibility_date": "2026-10-01",
 "workers_dev": false,
 "preview_urls": false,
 "assets": { "directory": "../frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
 "observability": { "enabled": true, "head_sampling_rate": 1 },
 "vars": { "APP_ENV": "production" },
 "d1_databases": [
   { "binding": "DB", "database_name": "cloudexpense", "migrations_dir": "migrations" }
 ]
}